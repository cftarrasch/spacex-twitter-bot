# SpaceX API
SPACEX_API_BASE_URL=https://api.spacexdata.com/v4

# Bot behavior
MODEL_PATH=models/spacex_success.joblib
STATE_PATH=data/bot_state.json
POST_WINDOW_HOURS=48
MAX_STALE_HOURS=6
DRY_RUN=true

# X/Twitter credentials. Required only when DRY_RUN=false.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

